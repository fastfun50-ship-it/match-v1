---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Find job — Match for vikarer" description="Opret dig. Vi matcher dig med virksomheder, der har brug for dig.">
  <section class="page-bleed" aria-label="Vikarer">
    <img class="page-bleed__img" src="/images/door-vikar-01.jpg" alt="" width="2400" height="1350" fetchpriority="high" />
    <div class="page-bleed__overlay"></div>
    <div class="page-bleed__content container">
      <h1>Find job</h1>
      <p class="page-bleed__lead">
        Opret dig — vi matcher dig med virksomheder. Vi er ikke din arbejdsgiver.
      </p>
      <a class="btn btn-sol" href="/opret/vikar">Opret dig</a>
    </div>
  </section>
  <section class="section section-sparse">
    <div class="container prose">
      <h2>Det rigtige match</h2>
      <p>Fag, område og hvad der er vigtigt for dig styrer matchingen. Ingen CV-upload i denne version.</p>
    </div>
  </section>
</Layout>
