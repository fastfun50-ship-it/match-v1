---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Cookies — Match" description="Kort cookie-information for Match.">
  <section class="page-hero">
    <div class="container"><h1>Cookies</h1></div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>
        Denne udkast-site bruger kun nødvendige cookies/teknologi til at vise siderne.
        Der er ingen marketing-cookies i denne version.
      </p>
      <p>
        Hvis vi senere tilføjer statistik eller marketing, opdaterer vi denne side og indhenter samtykke, hvor det kræves.
      </p>
    </div>
  </section>
</Layout>
