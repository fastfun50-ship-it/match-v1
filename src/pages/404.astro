---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Siden findes ikke — Match">
  <section class="section" style="padding-top:3.5rem;">
    <div class="container" style="text-align:center; max-width:36rem;">
      <h1>404</h1>
      <p class="muted">Siden findes ikke. Måske et forkert link — eller vi har flyttet noget.</p>
      <p style="margin-top:1.5rem; display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
        <a class="btn btn-signal" href="/virksomheder">Find vikar</a>
        <a class="btn btn-sol" href="/vikarer">Find job</a>
        <a class="btn btn-outline-navy" href="/">Forside</a>
      </p>
    </div>
  </section>
</Layout>
