---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Tak — Match" description="Tak for din henvendelse.">
  <section class="section" style="padding-top:3.5rem;">
    <div class="container" style="text-align:center; max-width:36rem;">
      <h1>Tak</h1>
      <p class="muted">
        Vi har modtaget din henvendelse (udkast — ingen rigtig backend endnu).
        Vi vender tilbage, når systemet er koblet på.
      </p>
      <p style="margin-top:1.5rem; display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
        <a class="btn btn-navy" href="/">Til forsiden</a>
        <a class="btn btn-outline-navy" href="/jobs">Se jobs</a>
      </p>
    </div>
  </section>
</Layout>
